# ============================================================
# invoice-request-parse — 配置模板
# 用法：复制本文件为同目录下的 config.yaml，并按需修改。
# config.yaml 已被 .gitignore 排除，不会推到 GitHub。
# ============================================================

# --- 关键词（表格识别）---
keywords:
  invoice_table: "开票申请"              # 选表关键字（优先匹配 sheet 名）
  table_parser:
    mode_priority: ["key_value", "column_index"]  # 优先尝试模式
    field_mapping:                                # 键值对模式字段映射
      amount: ["开票金额", "金额", "实付金额"]
      order_id: ["订单号", "订单编号", "主订单ID"]
      note: ["备注"]
      title: ["发票抬头", "抬头", "购买方名称", "公司名称"]          # 不用模糊别名"名称"，避免与「商品名称」列冲突
      tax_id: ["税号", "统一社会信用代码", "纳税人识别号", "购方识别号"]
    column_indices:                               # 列索引模式兜底（1-based）
      amount: 8
      order_id: 10
      note: 14
      title: 4                                    # 第4列「公司名称/姓名」= 发票抬头
      tax_id: 5                                   # 第5列「公司税号」= 税号

# --- 订单号 ---
order_no:
  valid_lengths: [12, 16]              # 合法订单号数字长度

# --- 去重 ---
dedup:
  check_history: true                  # 与历史 processed_emails.json 做订单号去重

# --- 解析失败重试（死信）---
parse:
  max_retry: 2                         # 侧车解析失败最多重试次数，超过则移入 handoff/failed/ 死信目录

# --- 交接目录（与 invoice-mail-monitor 共享，路径必须两边一致！）---
handoff:
  dir: "C:/Users/<你的用户名>/WorkBuddy/invoice_handoff"

# --- 报告输出 ---
output:
  dir: "C:/Users/<你的用户名>/WorkBuddy/invoice_handoff/reports"   # 生成 .md / .xlsx 双报告
