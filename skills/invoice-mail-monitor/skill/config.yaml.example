# ============================================================
# invoice-mail-monitor — 配置模板
# 用法：复制本文件为同目录下的 config.yaml，并按需修改。
# 注意：config.yaml 已被 .gitignore 排除，不会推到 GitHub（避免泄露凭证）。
# 真实账号/密码不要写死在此文件，改用环境变量注入（见 email.account/password）。
# ============================================================

# --- 邮箱连接（IMAP）---
email:
  server: "imap.qiye.aliyun.com"      # 阿里云企业邮箱 IMAP 服务器（按需替换）
  port: 993                            # SSL 端口
  account: "${INVOICE_EMAIL_ACCOUNT}"        # 优先读环境变量；也可直接填真实账号
  auth_type: "password"                # password | authcode
  password: "${INVOICE_EMAIL_PASSWORD}"       # 优先读环境变量；也可直接填
  # ⚠️ 密码须为纯 ASCII（不能用全角「！」等特殊字符），否则 IMAP 登录失败

# --- 关键词（邮件识别）---
# classifier 从 config["keywords"] 读取以下字段；请勿放到 email: 下。
keywords:
  invoice_body: ["发票", "开票"]       # R1：正文关键词
  invoice_table: "开票申请"              # R2：表格标题关键词
  urgent: ["加急"]                      # 加急识别关键词

# --- 交接目录（与 invoice-request-parse 共享，路径必须两边一致！）---
# monitor 把发票邮件的 xlsx + 侧车 json 写到 <dir>/pending/
# 留空则默认用 <skill根目录>/handoff（不推荐，需与 request-parse 对齐）
handoff:
  dir: "C:/Users/<你的用户名>/WorkBuddy/invoice_handoff"

# --- 定时调度（供 automation 参考，skill 本身不常驻）---
schedule:
  interval: "1h"
